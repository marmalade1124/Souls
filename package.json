{
  "name": "soul-island",
  "version": "0.3.1",
  "description": "A floating Windows desktop toolbar",
  "main": "src/main.js",
  "private": true,
  "author": "marmalade1124",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --win dir",
    "installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "in.soul.desktop",
    "productName": "Soul",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": ["src/media.ps1", "src/controls.ps1", "src/search.ps1", "src/native/**/*"],
    "win": {
      "target": ["dir", "nsis"],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Soul-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
