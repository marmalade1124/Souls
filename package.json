{
  "name": "soul-island",
  "version": "0.1.0",
  "description": "A floating Windows desktop toolbar",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --win dir"
  },
  "build": {
    "appId": "in.soul.desktop",
    "productName": "Soul",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": ["src/media.ps1", "src/controls.ps1"],
    "win": {
      "target": "dir",
      "icon": "src/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
